<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0;net462;net471</TargetFrameworks>
        <Description>Xbc.DbAccess 的 SQLite 数据库提供程序。</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="SqliteMetadataProvider.cs" />
        <Compile Remove="SqliteTypeMapper.cs" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Xbc.DbAccess.UnitTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- net462 用 1.0.116-117 浮动范围（2.x 不支持 .NET Framework），TFM 级覆盖中央版本 -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
        <PackageReference Include="System.Data.SQLite" VersionOverride="[1.0.116,1.0.117]" />
        <PackageReference Include="Stub.System.Data.SQLite.Core.NetFramework" VersionOverride="[1.0.116,1.0.117]" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net471'">
        <PackageReference Include="System.Data.SQLite" VersionOverride="2.0.1" />
        <PackageReference Include="Stub.System.Data.SQLite.Core.NetFramework" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="System.Data.SQLite" VersionOverride="2.0.1" />
        <PackageReference Include="Stub.System.Data.SQLite.Core.NetStandard" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Data.SQLite" VersionOverride="2.0.1" />
        <PackageReference Include="Stub.System.Data.SQLite.Core.NetStandard" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Xbc.DbAccess\Xbc.DbAccess.csproj" />
    </ItemGroup>

    <!-- DI 抽象（全目标提供 DI 扩展方法） -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
