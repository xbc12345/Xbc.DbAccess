<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>1701;1702;0300;0063;CS8618;CS8600;CS8601;CS8602;CS8604;CS8625;CS8765;CS8767;CA1822</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <NoWarn>1701;1702;0300;0063;CS8618;CS8600;CS8601;CS8602;CS8604;CS8625;CS8765;CS8767;CA1822</NoWarn>
    </PropertyGroup>

    <!-- 测试框架包版本与中央 Directory.Packages.props 保持一致 -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
        <PackageReference Include="xunit" Version="2.8.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- 覆盖率门禁（dotnet test -p:CollectCoverage=true 时采集并校验阈值，低于阈值测试失败） -->
        <PackageReference Include="coverlet.msbuild" Version="6.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Moq" Version="4.20.70" />
        <!-- Options 对齐 SqlServer 方言传递的 9.0.4（SqlClient 6.1.1 → Azure.Core 链），避免 NU1605 降级 -->
        <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.4" />
        <!-- BuildServiceProvider 构建测试容器（AddDbAccess 诊断自动接入验证），版本与中央 Directory.Packages.props 保持一致 -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <PackageReference Include="Stub.System.Data.SQLite.Core.NetStandard" Version="1.0.119" />
    </ItemGroup>

    <!-- 覆盖率门禁（coverlet.msbuild）：仅 dotnet test -p:CollectCoverage=true 时采集并校验，行覆盖低于阈值测试失败 -->
    <!-- 排除测试程序集自身；方言包（30%~74%）的方言特定路径（Upsert/连接管理/bulk 等）由真实库集成测试覆盖，当前基线 85.14%，阈值随覆盖提升逐步上调 -->
    <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
        <Exclude>[Xbc.DbAccess.UnitTests]*</Exclude>
        <Threshold>75</Threshold>
        <ThresholdType>line</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Xbc.DbAccess\Xbc.DbAccess.SqlServer\Xbc.DbAccess.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\src\Xbc.DbAccess\Xbc.DbAccess\Xbc.DbAccess.csproj" />
        <ProjectReference Include="..\..\..\src\Xbc.DbAccess\Xbc.DbAccess.Sqlite\Xbc.DbAccess.Sqlite.csproj" />
        <ProjectReference Include="..\..\..\src\Xbc.DbAccess\Xbc.DbAccess.MySql\Xbc.DbAccess.MySql.csproj" />
        <ProjectReference Include="..\..\..\src\Xbc.DbAccess\Xbc.DbAccess.Npgsql\Xbc.DbAccess.Npgsql.csproj" />
        <ProjectReference Include="..\..\..\src\Xbc.DbAccess\Xbc.DbAccess.Oracle\Xbc.DbAccess.Oracle.csproj" />
    </ItemGroup>

</Project>
