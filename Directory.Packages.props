<?xml version="1.0" encoding="utf-8"?>
<!--
  中央 NuGet 版本管理（仅覆盖 src 下启用 CPM 的项目）
  test/ 与 guides/ 各项目通过自身 Directory.Build.props 或 csproj 关闭了 CPM（ManagePackageVersionsCentrally=false），
  版本在各自 csproj 中独立管理，不依赖本文件
  添加新依赖时：1) 在此处添加版本  2) 在 csproj 中只写 <PackageReference Include="..." />
-->
<Project>

  <!-- ========== src 实际使用的包 ========== -->
  <ItemGroup>
    <!-- 主库：诊断（Meter/ActivitySource/选项热更新）与 DI 扩展 -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- JSON 列（[Column(IsJson = true)]）序列化 -->
    <PackageVersion Include="System.Text.Json" Version="10.0.9" />
    <!-- System.Diagnostics.Metrics（Meter），netstandard2.0 需要；net462 由 csproj VersionOverride 6.0.1 -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />

    <!-- SqlServer 方言（VersionOverride 9.0.4 对齐 SqlClient 6.1.1 传递链，避免 NU1605 降级） -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />

    <!-- MySql 方言 -->
    <PackageVersion Include="MySqlConnector" Version="2.4.0" />
    <!-- Npgsql 方言 -->
    <PackageVersion Include="Npgsql" Version="8.0.3" />
    <!-- Sqlite 方言 -->
    <PackageVersion Include="System.Data.SQLite" Version="1.0.118" />
    <PackageVersion Include="Stub.System.Data.SQLite.Core.NetFramework" Version="1.0.119" />
    <PackageVersion Include="Stub.System.Data.SQLite.Core.NetStandard" Version="1.0.119" />
    <!-- Oracle 方言 -->
    <PackageVersion Include="Oracle.ManagedDataAccess" Version="23.4.0" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.4.0" />

    <!-- Source Link（CI 打包，Directory.Build.props 中条件引用） -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

</Project>
